{
  "name": "pizza-yom-habocher-html",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pizza-yom-habocher",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "."
    }
  ],
  "vars": {
    "ADMIN_IDENTITY_MODE": "access"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}